---
/**
 * /commands — liste de toutes les commandes disponibles, groupées par catégorie.
 */
import HomeLayout from '../../layouts/HomeLayout.astro';
import Badge      from '../../components/ui/Badge.astro';
import { getCollection } from 'astro:content';
import { NAV_CATEGORIES } from '../../lib/nav';

const allCommands = await getCollection('commands');

/* Grouper par catégorie et trier */
const grouped = NAV_CATEGORIES.map(cat => ({
  ...cat,
  available: allCommands
    .filter(cmd => cmd.data.category === cat.slug)
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr')),
}));

const totalAvailable = allCommands.length;
const totalAll = NAV_CATEGORIES.reduce((acc, c) => acc + c.commandCount, 0);
---

<HomeLayout
  title="Toutes les commandes"
  description={`${totalAvailable} fiches disponibles sur ${totalAll} commandes documentées.`}
>
  <div class="cmd-index">
    <header class="cmd-index-header">
      <h1 class="cmd-index-title">Toutes les commandes</h1>
      <p class="cmd-index-sub">
        <span class="count-available">{totalAvailable}</span> fiche{totalAvailable > 1 ? 's' : ''} disponible{totalAvailable > 1 ? 's' : ''}
        sur <strong>{totalAll}</strong> commandes — les autres arrivent progressivement.
      </p>
    </header>

    {grouped.map(cat => cat.available.length > 0 && (
      <section class="cmd-section" aria-labelledby={`cat-${cat.slug}`}>
        <div class="cmd-section-header">
          <h2 id={`cat-${cat.slug}`} class="cmd-section-title">
            <a href={`/categories/${cat.slug}`}>{cat.title}</a>
          </h2>
          <span class="cmd-section-count">{cat.available.length} / {cat.commandCount}</span>
        </div>

        <ul class="cmd-list" role="list">
          {cat.available.map(cmd => (
            <li>
              <a href={`/commands/${cmd.id}`} class="cmd-card">
                <div class="cmd-card-title">{cmd.data.title}</div>
                <div class="cmd-card-desc">{cmd.data.description}</div>
                <div class="cmd-card-badges">
                  <Badge type="mode"       value={cmd.data.mode} />
                  <Badge type="difficulty" value={cmd.data.difficulty} />
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</HomeLayout>

<style>
.cmd-index {
  max-width: 900px;
  margin: 0 auto;
  padding: var(--space-8) var(--space-6) var(--space-16);
}

.cmd-index-header {
  margin-bottom: var(--space-10);
  padding-bottom: var(--space-6);
  border-bottom: 1px solid var(--color-border);
}

.cmd-index-title {
  font-size: var(--text-4xl);
  font-weight: 700;
  letter-spacing: var(--tracking-tight);
  color: var(--color-text);
  margin: 0 0 var(--space-3) 0;
}

.cmd-index-sub {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  margin: 0;
}

.count-available {
  font-weight: 700;
  color: var(--color-accent);
  font-size: var(--text-xl);
}

/* ---- Section catégorie ---- */
.cmd-section {
  margin-bottom: var(--space-10);
}

.cmd-section-header {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.cmd-section-title {
  font-size: var(--text-xl);
  font-weight: 600;
  margin: 0;
}

.cmd-section-title a {
  color: var(--color-text);
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease-out);
}

.cmd-section-title a:hover { color: var(--color-accent); }

.cmd-section-count {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
  background-color: var(--color-bg-muted);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
}

/* ---- Grille de commandes ---- */
.cmd-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--space-3);
}

.cmd-card {
  display: block;
  padding: var(--space-4);
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  text-decoration: none;
  transition:
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

.cmd-card:hover {
  border-color: var(--color-accent);
  box-shadow: var(--shadow-sm);
}

.cmd-card:focus-visible {
  outline: none;
  box-shadow: var(--ring);
}

.cmd-card-title {
  font-weight: 600;
  font-size: var(--text-sm);
  color: var(--color-text);
  margin-bottom: var(--space-1);
}

.cmd-card-desc {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: var(--leading-snug);
  margin-bottom: var(--space-3);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cmd-card-badges {
  display: flex;
  gap: var(--space-1);
  flex-wrap: wrap;
}
</style>
