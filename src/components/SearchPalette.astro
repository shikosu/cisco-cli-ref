---
/**
 * SearchPalette.astro — modal de recherche Ctrl+K avec Pagefind
 *
 * Raccourcis : Ctrl+K ou / → ouvrir ; Esc → fermer ;
 *              ↑ ↓ → naviguer ; Entrée → ouvrir la fiche sélectionnée.
 * Pagefind est chargé en lazy à la première ouverture (indisponible en dev).
 */
import Search  from '@lucide/astro/icons/search';
import Kbd     from './ui/Kbd.astro';
---

{/* Backdrop + modal */}
<div
  id="search-backdrop"
  class="search-backdrop"
  role="dialog"
  aria-modal="true"
  aria-label="Palette de recherche"
  hidden
>
  <div class="search-palette" id="search-palette">
    {/* Champ de saisie */}
    <div class="search-input-wrap">
      <Search size={18} class="search-input-icon" aria-hidden="true" />
      <input
        id="search-input"
        type="search"
        class="search-input"
        placeholder="Rechercher une commande Cisco…"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Rechercher"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button
        id="search-close-btn"
        class="search-close"
        aria-label="Fermer la recherche"
      >
        <Kbd>Esc</Kbd>
      </button>
    </div>

    {/* Zone de résultats */}
    <div
      id="search-results"
      class="search-results"
      role="listbox"
      aria-label="Résultats de recherche"
    >
      <p class="search-hint">
        Tape une commande ou un mot-clé — ex. <strong>vlan</strong>, <strong>ssh</strong>, <strong>route</strong>…
      </p>
    </div>

    {/* Pied de palette */}
    <div class="search-footer" aria-hidden="true">
      <span><Kbd>↑</Kbd><Kbd>↓</Kbd> Naviguer</span>
      <span><Kbd>↵</Kbd> Ouvrir</span>
      <span><Kbd>Esc</Kbd> Fermer</span>
    </div>
  </div>
</div>

<script>
import { initSearch, search } from '@/lib/search';
import type { SearchResult } from '@/lib/search';

/* ----------------------------------------------------------------
   Références DOM
   ---------------------------------------------------------------- */
const backdrop = document.getElementById('search-backdrop') as HTMLElement | null;
const input    = document.getElementById('search-input')    as HTMLInputElement | null;
const results  = document.getElementById('search-results')  as HTMLElement | null;

let selectedIndex = -1;
let currentResults: SearchResult[] = [];
let debounceTimer: ReturnType<typeof setTimeout> | null = null;

/* ----------------------------------------------------------------
   Ouvrir / fermer
   ---------------------------------------------------------------- */
async function openPalette(): Promise<void> {
  if (!backdrop) return;
  backdrop.hidden = false;
  document.body.style.overflow = 'hidden';
  requestAnimationFrame(() => input?.focus());
  /* Pré-charger Pagefind dès la première ouverture */
  initSearch();
}

function closePalette(): void {
  if (!backdrop) return;
  backdrop.hidden = true;
  document.body.style.overflow = '';
  if (input) input.value = '';
  clearResults();
}

/* ----------------------------------------------------------------
   Gestion des résultats
   ---------------------------------------------------------------- */
function clearResults(): void {
  selectedIndex = -1;
  currentResults = [];
  if (!results) return;
  results.innerHTML =
    '<p class="search-hint">Tape une commande ou un mot-clé — ex. <strong>vlan</strong>, <strong>ssh</strong>, <strong>route</strong>…</p>';
}

function renderResults(items: SearchResult[]): void {
  if (!results) return;
  currentResults = items;
  selectedIndex = -1;

  if (items.length === 0) {
    results.innerHTML =
      '<p class="search-hint search-hint--empty">Aucun résultat. Essaie <strong>show</strong>, <strong>vlan</strong> ou <strong>ssh</strong>.</p>';
    return;
  }

  results.innerHTML = items
    .map(
      (item, i) => `
    <a
      href="${item.url}"
      class="search-result"
      role="option"
      data-index="${i}"
      aria-selected="false"
    >
      <div class="search-result-title">${item.title}</div>
      <div class="search-result-excerpt">${item.excerpt}</div>
    </a>`
    )
    .join('');
}

function setSelected(index: number): void {
  const items = results?.querySelectorAll<HTMLElement>('.search-result');
  if (!items || items.length === 0) return;

  const clamped = Math.max(0, Math.min(index, items.length - 1));
  items.forEach((el, i) => {
    const active = i === clamped;
    el.classList.toggle('search-result--active', active);
    el.setAttribute('aria-selected', String(active));
    if (active) el.scrollIntoView({ block: 'nearest' });
  });
  selectedIndex = clamped;
}

/* ----------------------------------------------------------------
   Recherche avec debounce
   ---------------------------------------------------------------- */
async function doSearch(query: string): Promise<void> {
  const items = await search(query);
  renderResults(items);
}

/* ----------------------------------------------------------------
   Événements clavier
   ---------------------------------------------------------------- */
document.addEventListener('keydown', (e) => {
  /* Ctrl+K / Meta+K → toggle palette */
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
    e.preventDefault();
    backdrop?.hidden ? openPalette() : closePalette();
    return;
  }

  /* / hors d'un champ de saisie → ouvrir palette */
  if (
    e.key === '/' &&
    !backdrop?.hidden === false &&
    !(e.target instanceof HTMLInputElement) &&
    !(e.target instanceof HTMLTextAreaElement)
  ) {
    e.preventDefault();
    openPalette();
    return;
  }

  /* Raccourcis actifs uniquement quand la palette est ouverte */
  if (backdrop?.hidden) return;

  if (e.key === 'Escape') {
    closePalette();
    return;
  }

  const count = currentResults.length;
  if (count === 0) return;

  if (e.key === 'ArrowDown') {
    e.preventDefault();
    setSelected(selectedIndex < count - 1 ? selectedIndex + 1 : 0);
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    setSelected(selectedIndex > 0 ? selectedIndex - 1 : count - 1);
  } else if (e.key === 'Enter' && selectedIndex >= 0) {
    const link = results?.querySelector<HTMLAnchorElement>(
      `.search-result[data-index="${selectedIndex}"]`
    );
    if (link) {
      closePalette();
      window.location.href = link.href;
    }
  }
});

/* Événement personnalisé émis par le Header */
document.addEventListener('open-search-palette', openPalette);

/* Fermer en cliquant hors de la palette */
backdrop?.addEventListener('click', (e) => {
  if (e.target === backdrop) closePalette();
});

document.getElementById('search-close-btn')?.addEventListener('click', closePalette);

/* Recherche à la saisie (debounce 250 ms) */
input?.addEventListener('input', () => {
  const query = input.value.trim();
  if (debounceTimer) clearTimeout(debounceTimer);
  if (!query) {
    clearResults();
    return;
  }
  debounceTimer = setTimeout(() => doSearch(query), 250);
});
</script>

<style>
/* ---- Backdrop ---- */
.search-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgb(15 23 42 / 0.6);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: var(--z-modal);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 15vh;
  padding-inline: var(--space-4);
  animation: search-fade-in var(--duration-fast) var(--ease-out);
}

.search-backdrop[hidden] {
  display: none;
}

@keyframes search-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ---- Palette ---- */
.search-palette {
  width: 100%;
  max-width: 640px;
  background-color: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  animation: search-scale-in var(--duration-fast) var(--ease-out);
}

@keyframes search-scale-in {
  from { transform: scale(0.96); opacity: 0; }
  to   { transform: scale(1);    opacity: 1; }
}

/* ---- Champ de saisie ---- */
.search-input-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
  border-bottom: 1px solid var(--color-border);
}

.search-input-icon {
  color: var(--color-text-subtle);
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  border: none;
  background: none;
  font-family: var(--font-sans);
  font-size: var(--text-base);
  color: var(--color-text);
  outline: none;
  min-width: 0;
}

.search-input::placeholder {
  color: var(--color-text-subtle);
}

.search-input::-webkit-search-cancel-button { display: none; }

.search-close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  line-height: 1;
}

/* ---- Zone résultats ---- */
.search-results {
  max-height: 360px;
  overflow-y: auto;
  padding: var(--space-2) 0;
  scrollbar-width: thin;
  scrollbar-color: var(--color-border) transparent;
}

.search-hint {
  padding: var(--space-6) var(--space-4);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-align: center;
  margin: 0;
}

.search-hint--empty { color: var(--color-text-subtle); }

/* ---- Résultat individuel ---- */
.search-result {
  display: block;
  padding: var(--space-3) var(--space-4);
  text-decoration: none;
  transition: background-color var(--duration-fast) var(--ease-out);
  border-left: 2px solid transparent;
}

.search-result:hover,
.search-result--active {
  background-color: var(--color-accent-bg);
  border-left-color: var(--color-accent);
}

.search-result-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-1);
}

.search-result--active .search-result-title {
  color: var(--color-accent);
}

.search-result-excerpt {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: var(--leading-snug);

  /* Tronquer à 2 lignes */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Mise en valeur des termes trouvés par Pagefind */
:global(.search-result mark) {
  background: none;
  color: var(--color-accent);
  font-weight: 600;
}

/* ---- Pied ---- */
.search-footer {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-4);
  border-top: 1px solid var(--color-border);
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
  background-color: var(--color-bg-subtle);
}
</style>
