---
/**
 * CodeBlock — bloc de code avec fond sombre, bouton copier et coloration Cisco IOS
 *
 * Utilisé dans le contenu MDX pour les exemples de commandes.
 * Toujours sombre, même en light mode (imite un vrai terminal).
 */
interface Props {
  lang?: string;          /* cisco | bash | text (défaut: text) */
  title?: string;         /* titre optionnel de l'en-tête */
  showLineNumbers?: boolean;
  highlight?: number[];   /* numéros de lignes à mettre en évidence (base 1) */
}

const {
  lang = 'text',
  title,
  showLineNumbers = false,
  highlight = [],
} = Astro.props;

/* ----------------------------------------------------------------
   Récupération du texte brut depuis le slot
   MDX peut envelopper le contenu dans des <p> — on nettoie ça
   ---------------------------------------------------------------- */
const slotHtml = await Astro.slots.render('default');
const rawCode = slotHtml
  .replace(/<p>/g, '')
  .replace(/<\/p>/g, '\n')
  .replace(/<br\s*\/?>/gi, '\n')
  .replace(/<[^>]+>/g, '')
  .replace(/&amp;/g, '&')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .replace(/&nbsp;/g, ' ')
  .trim();

/* ----------------------------------------------------------------
   Utilitaire : échapper les caractères HTML
   ---------------------------------------------------------------- */
function esc(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

/* ----------------------------------------------------------------
   Coloration syntaxique regex — ligne par ligne
   ---------------------------------------------------------------- */
const CISCO_KW = new Set([
  'enable', 'disable', 'configure', 'terminal', 'conf', 'end', 'exit',
  'interface', 'ip', 'ipv6', 'vlan', 'hostname', 'no', 'shutdown', 'do',
  'show', 'write', 'memory', 'copy', 'service', 'username', 'password',
  'secret', 'privilege', 'login', 'local', 'transport', 'input', 'ssh',
  'telnet', 'crypto', 'key', 'generate', 'rsa', 'modulus', 'switchport',
  'mode', 'access', 'trunk', 'name', 'ping', 'traceroute', 'reload',
  'erase', 'route', 'static', 'default', 'gateway', 'address', 'description',
  'duplex', 'speed', 'auto', 'full', 'half', 'native', 'allowed',
  'encapsulation', 'dot1q', 'bandwidth', 'wr', 'clock', 'rate',
  'running-config', 'startup-config', 'domain-name', 'version',
  'line', 'vty', 'console', 'aux', 'banner', 'motd',
]);

const BASH_KW = new Set([
  'ssh', 'ping', 'traceroute', 'curl', 'wget', 'ls', 'cd', 'cat',
  'echo', 'grep', 'awk', 'sed', 'chmod', 'chown', 'sudo', 'apt',
  'npm', 'git', 'mkdir', 'rm', 'cp', 'mv', 'touch', 'find',
]);

function tokenizeLine(line: string, language: string): string {
  /* Lignes de commentaire : toute la ligne en gris */
  if (language === 'cisco' && /^\s*!/.test(line)) {
    return `<span class="tok-comment">${esc(line)}</span>`;
  }
  if (language === 'bash' && /^\s*#/.test(line)) {
    return `<span class="tok-comment">${esc(line)}</span>`;
  }

  /* Pas de coloration pour les autres langages */
  if (language !== 'cisco' && language !== 'bash') {
    return esc(line);
  }

  const kw = language === 'cisco' ? CISCO_KW : BASH_KW;

  /*
   * Découpage en tokens : séquences word (incl. tirets et points)
   * vs séquences non-word. Regex avec groupe capturant → les tokens
   * se retrouvent aux indices impairs du tableau résultant.
   */
  const parts = line.split(/(\w[\w.\-]*)/);

  return parts.map((part, i) => {
    if (i % 2 === 0) return esc(part); /* séparateur non-word */

    /* Adresse IP (ex: 192.168.1.0/24) */
    if (/^(\d{1,3}\.){3}\d{1,3}(\/\d{1,2})?$/.test(part)) {
      return `<span class="tok-number">${esc(part)}</span>`;
    }

    /* Nombre seul */
    if (/^\d+$/.test(part)) {
      return `<span class="tok-number">${esc(part)}</span>`;
    }

    /* Mot-clé Cisco / bash */
    if (kw.has(part.toLowerCase())) {
      return `<span class="tok-keyword">${esc(part)}</span>`;
    }

    return esc(part);
  }).join('');
}

/* ----------------------------------------------------------------
   Construction du HTML des lignes
   ---------------------------------------------------------------- */
const lines = rawCode.split('\n');
const highlightSet = new Set(highlight);

const renderedLines = lines.map((line, i) => {
  const num = i + 1;
  const isHighlighted = highlightSet.has(num);
  const tokenized = tokenizeLine(line, lang);
  const lineClass = isHighlighted ? 'code-line code-line--hl' : 'code-line';
  const lineNumHtml = showLineNumbers
    ? `<span class="line-num" aria-hidden="true">${num}</span>`
    : '';
  return `<span class="${lineClass}">${lineNumHtml}<span class="line-content">${tokenized}</span></span>`;
}).join('\n');

/* ID unique pour le bouton copier (isoler les instances sur une même page) */
const blockId = `cb-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="code-block" id={blockId} data-lang={lang}>
  {/* En-tête : title + bouton copier */}
  <div class="code-header">
    {title
      ? <span class="code-title">{title}</span>
      : <span class="code-lang">{lang !== 'text' ? lang : ''}</span>
    }
    <button
      class="copy-btn"
      data-target={blockId}
      aria-label="Copier le code"
      title="Copier"
    >
      {/* Icône Copy (SVG Lucide) */}
      <svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </svg>
      {/* Icône Check (SVG Lucide) */}
      <svg class="icon-check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </button>
  </div>

  {/* Bloc de code */}
  <pre class:list={['code-pre', showLineNumbers && 'with-line-numbers']}><code class="code-content" set:html={renderedLines} /></pre>
</div>

<script>
/* Gestion du bouton copier — délégation depuis .code-block */
document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
  btn.addEventListener('click', async () => {
    const targetId = btn.dataset.target;
    if (!targetId) return;

    const block = document.getElementById(targetId);
    if (!block) return;

    /* Extraire le texte brut depuis le bloc <pre><code> */
    const codeEl = block.querySelector('code');
    const text = codeEl?.innerText ?? '';

    try {
      await navigator.clipboard.writeText(text);
      /* Feedback visuel : afficher la coche 1500 ms */
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1500);
    } catch {
      /* Fallback silencieux si clipboard non disponible */
    }
  });
});
</script>

<style>
/* ---- Conteneur ---- */
.code-block {
  position: relative;
  background-color: var(--color-code-bg);
  border-radius: var(--radius-lg);
  border: 1px solid color-mix(in srgb, var(--color-code-fg) 8%, transparent);
  margin-bottom: var(--space-6);
  overflow: hidden;
}

/* ---- En-tête ---- */
.code-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-4);
  border-bottom: 1px solid color-mix(in srgb, var(--color-code-fg) 8%, transparent);
  background-color: color-mix(in srgb, var(--color-code-fg) 4%, transparent);
  min-height: 36px;
}

.code-title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-code-comment);
  letter-spacing: var(--tracking-wide);
}

.code-lang {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-code-comment);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
}

/* ---- Bouton copier ---- */
.copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  background: none;
  border: 1px solid color-mix(in srgb, var(--color-code-fg) 15%, transparent);
  border-radius: var(--radius-sm);
  color: var(--color-code-comment);
  cursor: pointer;
  transition:
    color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    background-color var(--duration-fast) var(--ease-out);
  flex-shrink: 0;
}

.copy-btn:hover {
  color: var(--color-code-fg);
  border-color: color-mix(in srgb, var(--color-code-fg) 30%, transparent);
  background-color: color-mix(in srgb, var(--color-code-fg) 6%, transparent);
}

.copy-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--color-code-bg), 0 0 0 4px var(--color-accent);
}

/* Swap icônes Copy ↔ Check */
.copy-btn .icon-check { display: none; }
.copy-btn.copied .icon-copy  { display: none; }
.copy-btn.copied .icon-check { display: block; color: var(--color-success); }

/* ---- Bloc pre/code ---- */
.code-pre {
  margin: 0;
  padding: var(--space-4) var(--space-4);
  overflow-x: auto;
  background: none;
  border: none;
  border-radius: 0;
}

.code-content {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: 400;
  line-height: var(--leading-snug);
  color: var(--color-code-fg);
  background: none;
  padding: 0;
  white-space: pre;
}

/* ---- Lignes ---- */
.code-line {
  display: block;
}

.code-line--hl {
  background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
  border-left: 2px solid var(--color-accent);
  margin-left: calc(-1 * var(--space-4));
  padding-left: calc(var(--space-4) - 2px);
  margin-right: calc(-1 * var(--space-4));
  padding-right: var(--space-4);
}

/* ---- Numéros de ligne ---- */
.with-line-numbers .line-num {
  display: inline-block;
  width: 2.5ch;
  text-align: right;
  margin-right: var(--space-4);
  color: var(--color-code-comment);
  user-select: none;
  opacity: 0.5;
  font-size: var(--text-sm);
}

/* ---- Tokens de coloration syntaxique ---- */
.tok-keyword { color: var(--color-code-keyword); }
.tok-number  { color: var(--color-code-number); }
.tok-comment { color: var(--color-code-comment); font-style: italic; }
.tok-string  { color: var(--color-code-string); }
.tok-punct   { color: var(--color-code-punct); }

/* ---- Scrollbar fine ---- */
.code-pre::-webkit-scrollbar { height: 4px; }
.code-pre::-webkit-scrollbar-track { background: transparent; }
.code-pre::-webkit-scrollbar-thumb {
  background: color-mix(in srgb, var(--color-code-fg) 20%, transparent);
  border-radius: 2px;
}
</style>
