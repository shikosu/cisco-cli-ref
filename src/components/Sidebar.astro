---
/**
 * Sidebar.astro — navigation latérale des commandes
 *
 * Desktop : colonne fixe 280px avec scroll indépendant.
 * Mobile (< 1024px) : drawer overlay (géré par DocsLayout).
 *
 * Catégories repliables via <details>/<summary> (natif HTML, accessible).
 * La catégorie contenant le lien actif s'ouvre automatiquement au chargement.
 */
import { NAV_CATEGORIES } from '../lib/nav';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import X            from '@lucide/astro/icons/x';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

/* Déterminer quelle catégorie est active (contient le lien courant) */
const activeCategorySlug = NAV_CATEGORIES.find(cat =>
  cat.items.some(item => currentPath.startsWith(`/commands/${cat.slug}`))
)?.slug ?? '';
---

<aside
  id="site-sidebar"
  class="sidebar"
  aria-label="Navigation des commandes"
  aria-hidden="false"
>
  {/* Bouton de fermeture (mobile) */}
  <div class="sidebar-header">
    <span class="sidebar-title">Commandes CLI</span>
    <button
      id="sidebar-close"
      class="sidebar-close"
      aria-label="Fermer la navigation"
    >
      <X size={18} aria-hidden="true" />
    </button>
  </div>

  {/* Liste des catégories */}
  <nav class="sidebar-nav" aria-label="Catégories de commandes">
    {NAV_CATEGORIES.map((cat) => {
      const isOpen = cat.slug === activeCategorySlug;
      return (
        <details class="sidebar-category" open={isOpen}>
          <summary class="sidebar-cat-header">
            <span class="sidebar-cat-label">{cat.title}</span>
            <span class="sidebar-cat-count">{cat.commandCount}</span>
            <ChevronRight size={14} class="sidebar-cat-arrow" aria-hidden="true" />
          </summary>
          <ul class="sidebar-items" role="list">
            {cat.items.map((item) => {
              const isActive = currentPath === item.href || currentPath === item.href + '/';
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={['sidebar-link', isActive && 'sidebar-link--active']}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
  </nav>

  {/* Pied de sidebar */}
  <div class="sidebar-footer">
    <a href="/categories" class="sidebar-footer-link">Toutes les catégories</a>
    <span class="sidebar-footer-sep" aria-hidden="true">·</span>
    <span class="sidebar-footer-count">
      {NAV_CATEGORIES.reduce((acc, c) => acc + c.commandCount, 0)} commandes
    </span>
  </div>
</aside>

<style>
/* ---- Sidebar principale ---- */
.sidebar {
  width: var(--layout-sidebar);
  flex-shrink: 0;
  position: sticky;
  top: var(--layout-header-h);
  height: calc(100vh - var(--layout-header-h));
  overflow-y: auto;
  background-color: var(--color-bg-subtle);
  border-right: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;

  /* Scrollbar fine */
  scrollbar-width: thin;
  scrollbar-color: var(--color-border-strong) transparent;
}

/* ---- Drawer mobile ---- */
@media (max-width: 1023px) {
  .sidebar {
    position: fixed;
    top: var(--layout-header-h);
    left: 0;
    height: calc(100% - var(--layout-header-h));
    z-index: var(--z-sidebar);
    transform: translateX(-100%);
    transition: transform var(--duration-normal) var(--ease-out);
    box-shadow: var(--shadow-lg);
  }

  :global(body.sidebar-open) .sidebar {
    transform: translateX(0);
  }
}

/* ---- En-tête sidebar ---- */
.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-4) var(--space-3);
  border-bottom: 1px solid var(--color-border);
  flex-shrink: 0;
}

.sidebar-title {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  color: var(--color-text-subtle);
}

.sidebar-close {
  display: none;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  background: none;
  border: none;
  border-radius: var(--radius-sm);
  color: var(--color-text-muted);
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-out);
}

.sidebar-close:hover {
  background-color: var(--color-bg-muted);
  color: var(--color-text);
}

.sidebar-close:focus-visible {
  outline: none;
  box-shadow: var(--ring);
}

@media (max-width: 1023px) {
  .sidebar-close { display: flex; }
}

/* ---- Navigation ---- */
.sidebar-nav {
  flex: 1;
  padding: var(--space-2) 0;
  overflow-y: auto;
}

/* ---- Catégorie (details/summary) ---- */
.sidebar-category {
  border: none;
}

.sidebar-cat-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  cursor: pointer;
  list-style: none;
  user-select: none;
  transition: background-color var(--duration-fast) var(--ease-out);
}

/* Masquer le triangle natif */
.sidebar-cat-header::-webkit-details-marker { display: none; }
.sidebar-cat-header::marker { display: none; }

.sidebar-cat-header:hover {
  background-color: var(--color-bg-muted);
}

.sidebar-cat-label {
  flex: 1;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  color: var(--color-text-subtle);
}

.sidebar-cat-count {
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
  background-color: var(--color-bg-muted);
  padding: 0 5px;
  border-radius: 10px;
  min-width: 18px;
  text-align: center;
  line-height: 18px;
  height: 18px;
}

/* Flèche — rotation au déploiement */
.sidebar-cat-arrow {
  color: var(--color-text-subtle);
  transition: transform var(--duration-fast) var(--ease-out);
  flex-shrink: 0;
}

details[open] .sidebar-cat-arrow {
  transform: rotate(90deg);
}

/* ---- Items de la catégorie ---- */
.sidebar-items {
  list-style: none;
  margin: 0;
  padding: 0 0 var(--space-2);
}

.sidebar-link {
  display: block;
  padding: 6px var(--space-4) 6px var(--space-8);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
  border-left: 2px solid transparent;
  transition:
    color var(--duration-fast) var(--ease-out),
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out);
  line-height: var(--leading-snug);
}

.sidebar-link:hover {
  color: var(--color-text);
  background-color: var(--color-bg-muted);
}

.sidebar-link:focus-visible {
  outline: none;
  box-shadow: inset var(--ring);
}

/* ---- Lien actif ---- */
.sidebar-link--active {
  color: var(--color-accent);
  background-color: var(--color-accent-bg);
  border-left-color: var(--color-accent);
  font-weight: 500;
}

.sidebar-link--active:hover {
  color: var(--color-accent-hover);
  background-color: var(--color-accent-bg);
}

/* ---- Pied de sidebar ---- */
.sidebar-footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  border-top: 1px solid var(--color-border);
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
}

.sidebar-footer-link {
  color: var(--color-accent);
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease-out);
}

.sidebar-footer-link:hover {
  color: var(--color-accent-hover);
  text-decoration: underline;
}
</style>
