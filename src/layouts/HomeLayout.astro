---
/**
 * HomeLayout.astro — layout de la page d'accueil
 * Composition : Layout → Header + <main> + Footer
 */
import Layout   from './Layout.astro';
import Header   from '../components/Header.astro';
import Footer   from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cisco CLI Reference',
  description,
} = Astro.props;
---

<Layout title={title} description={description}>
  <Header />
  <main id="main" class="home-main">
    <slot />
  </main>
  <Footer />
  <SearchPalette />
</Layout>

<style>
.home-main {
  min-height: calc(100vh - var(--layout-header-h) - 120px);
}
</style>
